{
  "name": "openadr-3-ts-types-builder",
  "version": "3.0.1",
  "description": "TypeScript types for use with OpenADR v3",
  "main": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "config": {
    "openadryaml": "../oadr3.0.1.yaml",
    "zodoutput": "../package/src/zod/",
    "zodoutput_dev": "./zod/",
    "joioutput": "../package/src/joi/oadr3.ts",
    "joioutput_dev": "./oadr3.ts",
    "typegenoutput": "typegen/openadr-3.d.ts"
  },
  "scripts": {
    "build": "npm-run-all build:zod build:joi build:codegen build:codegen-schemas build:openapi-typescript",
    "build:zod": "npx zx build-openapi-to-zod.js",
    "build:joi": "npx zx build-openapi-to-joi.js",
    "build:codegen": "npx zx build-codegen.js",
    "build:typegen": "npx zx build-typegen.js",
    "build:openapi2jsonschema": "npx zx build-openapi2jsonschema.js",
    "build:openapi-typescript": "npx zx build-openapi-typescript.js",
    "build:ts-to-zod": "npx zx build-ts-to-zod.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robogeek/openadr-3-ts-types.git"
  },
  "keywords": [
    "OpenADR",
    "Energy",
    "Efficiency"
  ],
  "author": "David Herron <david@davidherron.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/robogeek/openadr-3-ts-types/issues"
  },
  "homepage": "https://github.com/robogeek/openadr-3-ts-types#readme",
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.53.7",
    "dtsgenerator": "^3.19.1",
    "openapi-client-axios-typegen": "^7.4.1",
    "openapi-ts-json-schema": "^0.12.2",
    "openapi-typescript-codegen": "^0.25.0",
    "openapi3-generator": "^0.13.0",
    "openapicmd": "^2.0.1"
  },
  "engines": {
    "node": "^18 || >=20"
  },
  "dependencies": {
    "@anttiviljami/dtsgenerator": "^3.20.0",
    "@hey-api/client-axios": "^0.2.7",
    "@hey-api/client-fetch": "^0.4.0",
    "@openapi-codegen/cli": "^2.0.0",
    "@openapi-codegen/typescript": "^8.0.0",
    "@openapi-contrib/openapi-schema-to-json-schema": "^5.1.0",
    "@openapitools/openapi-generator-cli": "^2.13.13",
    "@savotije/openapi-to-joi": "2.2.0",
    "core-types-json-schema": "^2.2.0",
    "npm-run-all": "^4.1.5",
    "openapi-format": "^1.24.2",
    "openapi-json-schema": "^2.0.0",
    "openapi-to-zod": "^0.0.9",
    "openapi-typescript": "^6.7.2",
    "ts-to-zod": "^3.4.1",
    "typeconv": "^2.3.1",
    "zx": "^8.1.8"
  }
}
